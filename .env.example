# Copy this file to ".env" and fill it in.
# Free Alpaca keys: https://alpaca.markets -> Paper Trading -> Generate API Keys

# ---- Live data feed ----
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
DATA_FEED=iex                 # iex = free real-time; sip = paid full-market
WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL,META,AMD,NFLX,SPY

# ---- Alerts (optional; blank = print to screen only) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SECONDS=60

# ---- Daily report email (Gmail SMTP; blank = email delivery disabled) ----
# GMAIL_APP_PASSWORD is a 16-char Google App Password (NOT your account password): myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
BOSS_EMAIL=

# ---- Supabase push (VIP Agent delivers the SAME .docx/.pdf; blank = push disabled) ----
# Additive to the email: uploads the finished KO+EN .docx/.pdf to Storage (bucket "youtube-reports")
# and inserts one public.orch_reports row so the "Oasis VIP Agent" can deliver the EXACT same files.
# SUPABASE_KEY is the service-role key — keep it in your private .env, NEVER commit it, NEVER log it.
SUPABASE_URL=
SUPABASE_KEY=

# ---- Live state tracking ----
ROLLING_WINDOW_SECONDS=60
STALE_AFTER_SECONDS=30

# ---- Risk management (the safety layer) ----
ACCOUNT_EQUITY=100000         # your paper account size
RISK_PER_TRADE_PCT=0.5        # % of equity risked per trade
MAX_POSITION_PCT=10           # max % of equity in one position
STOP_LOSS_PCT=2.0             # stop-loss distance
TAKE_PROFIT_PCT=4.0           # take-profit distance
MAX_DAILY_LOSS_PCT=3.0        # halt trading after this daily loss

# ---- Costs (used by the backtest so results are realistic) ----
TRANSACTION_COST_BPS=5        # round-trip fees, basis points
SLIPPAGE_BPS=2                # assumed slippage, basis points

# ---- Kiwoom (KR) live feed ----
# Issue keys at openapi.kiwoom.com. Start on the MOCK (simulation) server.
# NEVER commit real keys — keep them in your private .env, not in this example.
KIWOOM_ENV=mock                # mock = simulation server, live = production
KIWOOM_APP_KEY=                # your Kiwoom REST app key
KIWOOM_SECRET_KEY=             # your Kiwoom REST secret key

# ---- News & alerts (rule-based filters; NOT a price-prediction feature) ----
# OpenDART (KR disclosures): free key at https://opendart.fss.or.kr (오픈API -> 인증키 신청)
OPENDART_API_KEY=
# Finnhub (US news + sentiment): free key at https://finnhub.io
FINNHUB_API_KEY=

# ---- Minute-data vendor (intraday backtest history) ----
# iTick (OHLCV): free key at https://itick.org  (NOTE: does NOT cover KR/KOSPI)
ITICK_API_KEY=
# EODHD (intraday OHLCV): key at https://eodhd.com  (KR = .KO suffix, e.g. 005930.KO)
EODHD_API_KEY=

# ---- KRX data login (unlocks pykrx's gated 공매도 / 수급 endpoints) ----
# A free data.krx.co.kr account. pykrx auto-logs-in using these. If KRX rejects
# them ("자격 증명을 확인하세요"), download the CSVs manually instead.
KRX_ID=                        # data.krx.co.kr login id
KRX_PW=                        # data.krx.co.kr password

# ---- 머니업 YouTube extraction / summaries ----
# Gemini (summaries + label-merge): key at https://aistudio.google.com/apikey. NEVER commit the real key.
GEMINI_API_KEY=
# Optional Gemini model overrides (non-secret; leave blank for defaults)
GEMINI_MODEL=
GEMINI_EXTRACT_MODEL=
GEMINI_INTERACTIVE_MODEL=
MONEYUP_GEMINI_MODEL=
# OpenAI (optional alternate LLM)
OPENAI_API_KEY=
# YouTube Data API (channel/video listing) — key at https://console.cloud.google.com
YOUTUBE_API_KEY=
YOUTUBE_CHANNELS=              # comma-separated channel ids/handles to collect
YOUTUBE_TRANSCRIPT_MODE=       # e.g. auto | whisper
# Whisper (local transcription; non-secret config)
WHISPER_MODEL=                 # e.g. large-v3
WHISPER_DEVICE=                # e.g. cuda | cpu
# Webshare rotating proxy for transcript fetch (optional) — SECRET, keep in .env only
WEBSHARE_PROXY_PASSWORD=
# Naver API (KR news/search) — id+secret at https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=